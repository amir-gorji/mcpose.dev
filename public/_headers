# Served by Cloudflare Workers static assets. Next.js copies public/ into out/,
# so this file lands at the root of the asset directory where Cloudflare expects it.
# Note: these apply to static asset responses only.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# `opengraph-image` is a Next.js metadata route. Next only appends a file
# extension for robots/manifest/sitemap, so a code-generated image route lands
# in out/ as an extensionless file. Cloudflare derives Content-Type from the
# extension, finds none, and serves the PNG with no Content-Type at all — which
# combined with the nosniff above forbids every crawler from rendering the card.
# Query strings do not affect matching, so this also covers the ?<hash> form
# Next puts in the og:image URL.
/opengraph-image
  Content-Type: image/png

# Content-hashed filenames — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Only pagefind's index/ and fragment/ chunks carry a content hash in the
# filename. pagefind-entry.json is the stable manifest that points at those
# hashes, and pagefind-ui.* keep fixed names — caching either one immutably
# would strand search on a stale index after a content change, so they are
# deliberately left on the default revalidating cache.
# Known hazard: Cloudflare applies these rules to 404 responses too, so a client
# holding a stale pagefind-entry.json can pin a 404 body for a year. _headers has
# no way to condition on status; the mitigation is that entry.json itself is
# always revalidated, so the stale window closes on the next page load.
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
